{
  "rules": {
    "phoneking": {
      "data": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email == 'phonekingkd@gmail.com' || (root.child('phoneking/users').child(auth.uid).child('role').val() == 'staff' && root.child('phoneking/users').child(auth.uid).child('active').val() == true && root.child('phoneking/users').child(auth.uid).child('access').val() == 'full'))"
      },
      "users": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'phonekingkd@gmail.com')",
          ".write": "auth != null && auth.token.email == 'phonekingkd@gmail.com'"
        }
      },
      "history": {
        ".read": "auth != null && (auth.token.email == 'phonekingkd@gmail.com' || (root.child('phoneking/users').child(auth.uid).child('role').val() == 'staff' && root.child('phoneking/users').child(auth.uid).child('active').val() == true && root.child('phoneking/users').child(auth.uid).child('access').val() == 'full'))",
        "$id": {
          ".write": "auth != null && (auth.token.email == 'phonekingkd@gmail.com' || (root.child('phoneking/users').child(auth.uid).child('role').val() == 'staff' && root.child('phoneking/users').child(auth.uid).child('active').val() == true && root.child('phoneking/users').child(auth.uid).child('access').val() == 'full' && !data.exists() && newData.child('userId').val() == auth.uid))",
          ".validate": "newData.hasChildren(['createdAt','userId','userName','userEmail','action','entity','details']) && newData.child('userId').isString() && newData.child('createdAt').isNumber()"
        },
        ".indexOn": ["createdAt"]
      }
    }
  }
}
